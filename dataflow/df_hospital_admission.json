{
	"name": "df_hospital_admission",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_hospital_datasource",
						"type": "DatasetReference"
					},
					"name": "hospitaladmission"
				},
				{
					"dataset": {
						"referenceName": "ds_lookup",
						"type": "DatasetReference"
					},
					"name": "lookupsource"
				},
				{
					"dataset": {
						"referenceName": "ds_dim_data_lookup",
						"type": "DatasetReference"
					},
					"name": "lookupdim"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_daily_sink",
						"type": "DatasetReference"
					},
					"name": "sinkDaily"
				},
				{
					"dataset": {
						"referenceName": "ds_weekly_sink",
						"type": "DatasetReference"
					},
					"name": "sinkWeekly"
				}
			],
			"transformations": [
				{
					"name": "selectReqFields"
				},
				{
					"name": "hospitallookupcountry"
				},
				{
					"name": "selectReqFields2"
				},
				{
					"name": "splitWeekly"
				},
				{
					"name": "aggDimDate"
				},
				{
					"name": "joinDimHospital"
				},
				{
					"name": "selectDesirecCoumns"
				},
				{
					"name": "pivotWeekly"
				},
				{
					"name": "pivotDaily"
				},
				{
					"name": "soryDaily"
				},
				{
					"name": "sortWeekly"
				},
				{
					"name": "selectDaily"
				},
				{
					"name": "selectWeekly"
				}
			],
			"scriptLines": [
				"source(output(",
				"          country as string,",
				"          indicator as string,",
				"          date as date,",
				"          year_week as string,",
				"          value as double,",
				"          source as string,",
				"          url as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> hospitaladmission",
				"source(output(",
				"          country as string,",
				"          country_code_2_digit as string,",
				"          country_code_3_digit as string,",
				"          continent as string,",
				"          population as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> lookupsource",
				"source(output(",
				"          date_key as string,",
				"          date as string,",
				"          year as string,",
				"          month as string,",
				"          day as string,",
				"          day_name as string,",
				"          day_of_year as string,",
				"          week_of_month as string,",
				"          week_of_year as string,",
				"          month_name as string,",
				"          year_month as string,",
				"          year_week as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> lookupdim",
				"hospitaladmission select(mapColumn(",
				"          country,",
				"          indicator,",
				"          reported_date = date,",
				"          reported_year_week = year_week,",
				"          value,",
				"          source",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectReqFields",
				"selectReqFields, lookupsource lookup(selectReqFields@country == lookupsource@country,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> hospitallookupcountry",
				"hospitallookupcountry select(mapColumn(",
				"          country = selectReqFields@country,",
				"          indicator,",
				"          reported_date,",
				"          reported_year_week,",
				"          value,",
				"          source,",
				"          country = lookupsource@country,",
				"          country_code_2_digit,",
				"          country_code_3_digit,",
				"          population",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectReqFields2",
				"selectReqFields2 split(indicator == \"Daily hospital occupancy\" || indicator == \"Daily ICU occupancy\",",
				"     disjoint: false) ~> splitWeekly@(Daily, Weekly)",
				"lookupdim aggregate(groupBy(ecdc_year_week = year+'-W'+lpad(day,2,'0')),",
				"     min = min(date),",
				"          max = max(date)) ~> aggDimDate",
				"splitWeekly@Weekly, aggDimDate join(reported_year_week == ecdc_year_week,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinDimHospital",
				"joinDimHospital select(mapColumn(",
				"          country,",
				"          indicator,",
				"          reported_date,",
				"          reported_year_week,",
				"          value,",
				"          source,",
				"          country_code_2_digit,",
				"          country_code_3_digit,",
				"          population,",
				"          min,",
				"          max",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectDesirecCoumns",
				"selectDesirecCoumns pivot(groupBy(country,",
				"          reported_date,",
				"          reported_year_week,",
				"          source,",
				"          country_code_2_digit,",
				"          country_code_3_digit,",
				"          min,",
				"          max),",
				"     pivotBy(indicator, ['Weekly new hospital admissions per 100k', 'Weekly new ICU admissions per 100k']),",
				"     count = sum(value),",
				"     columnNaming: '$V_$N',",
				"     lateral: true) ~> pivotWeekly",
				"splitWeekly@Daily pivot(groupBy(country,",
				"          reported_date,",
				"          reported_year_week,",
				"          source,",
				"          population,",
				"          country_code_2_digit,",
				"          country_code_3_digit),",
				"     pivotBy(indicator, ['Daily hospital occupancy', 'Daily ICU occupancy']),",
				"     count = sum((value)),",
				"     columnNaming: '$N_$V',",
				"     lateral: true) ~> pivotDaily",
				"pivotDaily sort(asc(country, true),",
				"     desc(reported_date, true),",
				"     caseInsensitive: true) ~> soryDaily",
				"pivotWeekly sort(asc(country, true),",
				"     desc(reported_year_week, true),",
				"     caseInsensitive: true) ~> sortWeekly",
				"soryDaily select(mapColumn(",
				"          country,",
				"          country_code_2_digit,",
				"          country_code_3_digit,",
				"          population,",
				"          reported_date,",
				"          {count_Daily hospital occupancy},",
				"          {count_Daily ICU occupancy},",
				"          source",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectDaily",
				"sortWeekly select(mapColumn(",
				"          country,",
				"          country_code_2_digit,",
				"          country_code_3_digit,",
				"          reported_year_week,",
				"          reported_start_date = min,",
				"          reported_end_date = max,",
				"          {Weekly new hospital admissions per 100k_count},",
				"          {Weekly new ICU admissions per 100k_count},",
				"          source",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectWeekly",
				"selectDaily sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkDaily",
				"selectWeekly sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkWeekly"
			]
		}
	}
}