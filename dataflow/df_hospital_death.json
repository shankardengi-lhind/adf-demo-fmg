{
	"name": "df_hospital_death",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_for_dataflow_source_death",
						"type": "DatasetReference"
					},
					"name": "coviddeathdatasource"
				},
				{
					"dataset": {
						"referenceName": "ds_lookup",
						"type": "DatasetReference"
					},
					"name": "lookupsource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_dataflow_sink",
						"type": "DatasetReference"
					},
					"name": "sinkukdeatandconfirmedcase"
				}
			],
			"transformations": [
				{
					"name": "filtereurope"
				},
				{
					"name": "selectdeathcolumns"
				},
				{
					"name": "pivotindicator"
				},
				{
					"name": "lookuppviotsource"
				}
			],
			"scriptLines": [
				"source(output(",
				"          country as string,",
				"          country_code as string,",
				"          continent as string,",
				"          population as integer,",
				"          indicator as string,",
				"          daily_count as integer,",
				"          date as date,",
				"          rate_14_day as double,",
				"          source as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> coviddeathdatasource",
				"source(output(",
				"          country as string,",
				"          country_code_2_digit as string,",
				"          country_code_3_digit as string,",
				"          continent as string,",
				"          population as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> lookupsource",
				"coviddeathdatasource filter(continent=='Europe') ~> filtereurope",
				"filtereurope select(mapColumn(",
				"          country,",
				"          country_code,",
				"          population,",
				"          indicator,",
				"          daily_count,",
				"          source,",
				"          each(match(name=='date'),",
				"               'reported'+'_date' = $$)",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> selectdeathcolumns",
				"selectdeathcolumns pivot(groupBy(country,",
				"          country_code,",
				"          population,",
				"          source,",
				"          reported_date),",
				"     pivotBy(indicator, ['confirmed cases', 'deaths']),",
				"     count = sum(daily_count),",
				"     columnNaming: '$V$N',",
				"     lateral: true) ~> pivotindicator",
				"pivotindicator, lookupsource lookup(pivotindicator@country == lookupsource@country,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookuppviotsource",
				"lookuppviotsource sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     mapColumn(",
				"          country = pivotindicator@country,",
				"          country_code,",
				"          population = pivotindicator@population,",
				"          source,",
				"          reported_date,",
				"          {confirmed casescount},",
				"          deathscount,",
				"          country_code_2_digit,",
				"          country_code_3_digit,",
				"          continent",
				"     )) ~> sinkukdeatandconfirmedcase"
			]
		}
	}
}