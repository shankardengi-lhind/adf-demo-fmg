{
	"name": "pl_ingestion_http_dl",
	"properties": {
		"activities": [
			{
				"name": "lkp_metadata",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "ds_metadata_json",
						"type": "DatasetReference",
						"parameters": {
							"metadata_folder": {
								"value": "@pipeline().parameters.metadata_location",
								"type": "Expression"
							},
							"metadata_filename": {
								"value": "@pipeline().parameters.metadata_filename",
								"type": "Expression"
							}
						}
					}
				}
			}
		],
		"parameters": {
			"metadata_location": {
				"type": "string",
				"defaultValue": "metadata"
			},
			"sink_data_location": {
				"type": "string"
			},
			"metadata_filename": {
				"type": "string",
				"defaultValue": "githubusercontent_ecdc_file_list.json"
			}
		},
		"annotations": []
	}
}