{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-fmg-demo"
		},
		"ls_ablob_covidreportingsa_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_ablob_covidreportingsa'"
		},
		"ls_metadata_dl_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_metadata_dl'"
		},
		"ls_sink_dl_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_sink_dl'"
		},
		"ls_metadata_dl_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adfdemofmg.dfs.core.windows.net/"
		},
		"ls_sink_dl_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adfdemofmg.dfs.core.windows.net/"
		},
		"ls_source_http_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "@{linkedService().base_url}"
		},
		"tr_ingestion_properties_pl_ingestion_http_dl_parameters_metadata_location": {
			"type": "string",
			"defaultValue": "metadata"
		},
		"tr_ingestion_properties_pl_ingestion_http_dl_parameters_sink_data_location": {
			"type": "string",
			"defaultValue": "ecdc-folder"
		},
		"tr_ingestion_properties_pl_ingestion_http_dl_parameters_metadata_filename": {
			"type": "string",
			"defaultValue": "githubusercontent_ecdc_file_list.json"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-fmg-demo_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_ablob_covidreportingsa_connectionString": {
						"value": "[parameters('ls_ablob_covidreportingsa_connectionString')]"
					},
					"ls_metadata_dl_accountKey": {
						"value": "[parameters('ls_metadata_dl_accountKey')]"
					},
					"ls_sink_dl_accountKey": {
						"value": "[parameters('ls_sink_dl_accountKey')]"
					},
					"ls_metadata_dl_properties_typeProperties_url": {
						"value": "[parameters('ls_metadata_dl_properties_typeProperties_url')]"
					},
					"ls_sink_dl_properties_typeProperties_url": {
						"value": "[parameters('ls_sink_dl_properties_typeProperties_url')]"
					},
					"ls_source_http_properties_typeProperties_url": {
						"value": "[parameters('ls_source_http_properties_typeProperties_url')]"
					},
					"tr_ingestion_properties_pl_ingestion_http_dl_parameters_metadata_location": {
						"value": "[parameters('tr_ingestion_properties_pl_ingestion_http_dl_parameters_metadata_location')]"
					},
					"tr_ingestion_properties_pl_ingestion_http_dl_parameters_sink_data_location": {
						"value": "[parameters('tr_ingestion_properties_pl_ingestion_http_dl_parameters_sink_data_location')]"
					},
					"tr_ingestion_properties_pl_ingestion_http_dl_parameters_metadata_filename": {
						"value": "[parameters('tr_ingestion_properties_pl_ingestion_http_dl_parameters_metadata_filename')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}